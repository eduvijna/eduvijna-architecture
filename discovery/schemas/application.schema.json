{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://eduvijna.local/discovery/schemas/application.schema.json",
  "title": "Application Discovery Inventory",
  "description": "Validates application discovery inventories completed from discovery/templates/application-template.yaml. Metadata and evidence are defined in common-metadata.schema.json.",
  "type": "object",
  "required": [
    "metadata",
    "application",
    "evidence",
    "unknown_value_policy",
    "reproducibility"
  ],
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "allOf": [
        {
          "$ref": "common-metadata.schema.json#/$defs/metadata"
        },
        {
          "type": "object",
          "properties": {
            "discovery_type": {
              "const": "application"
            }
          }
        }
      ]
    },
    "application": {
      "type": "object",
      "required": [
        "application_id",
        "name",
        "application_type",
        "lifecycle_status",
        "business_owner",
        "technical_owner",
        "primary_purpose"
      ],
      "additionalProperties": false,
      "properties": {
        "application_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "application_type": {
          "type": "string",
          "enum": [
            "web",
            "api",
            "batch",
            "mobile",
            "desktop",
            "platform",
            "other",
            "UNKNOWN"
          ]
        },
        "lifecycle_status": {
          "type": "string",
          "enum": [
            "planned",
            "active",
            "maintenance",
            "deprecated",
            "retired",
            "UNKNOWN"
          ]
        },
        "business_owner": {
          "$ref": "#/$defs/stringOrUnknown"
        },
        "technical_owner": {
          "$ref": "#/$defs/stringOrUnknown"
        },
        "primary_purpose": {
          "$ref": "#/$defs/stringOrUnknown"
        }
      }
    },
    "evidence": {
      "$ref": "common-metadata.schema.json#/$defs/evidence"
    },
    "unknown_value_policy": {
      "$ref": "#/$defs/unknownValuePolicy"
    },
    "observations": {
      "$ref": "#/$defs/observations"
    },
    "assumptions": {
      "$ref": "#/$defs/assumptions"
    },
    "reproducibility": {
      "$ref": "#/$defs/reproducibility"
    },
    "application_optional": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "user_communities": {
          "$ref": "#/$defs/stringList"
        },
        "environments": {
          "$ref": "#/$defs/stringList"
        },
        "repository_ids": {
          "$ref": "#/$defs/stringList"
        },
        "capability_ids": {
          "$ref": "#/$defs/stringList"
        },
        "technology_ids": {
          "$ref": "#/$defs/stringList"
        },
        "criticality": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical",
            "UNKNOWN",
            ""
          ]
        },
        "data_classification": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringOrUnknown": {
      "type": "string",
      "minLength": 1
    },
    "isoDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "dateOrEmpty": {
      "type": "string",
      "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$"
    },
    "tfu": {
      "type": "string",
      "enum": [
        "true",
        "false",
        "UNKNOWN"
      ]
    },
    "tfuEmpty": {
      "type": "string",
      "enum": [
        "true",
        "false",
        "UNKNOWN",
        ""
      ]
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unknownValuePolicy": {
      "type": "object",
      "required": [
        "statement",
        "marker",
        "fields_marked_unknown",
        "rationale_required"
      ],
      "additionalProperties": false,
      "properties": {
        "statement": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "marker": {
          "const": "UNKNOWN"
        },
        "fields_marked_unknown": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rationale_required": {
          "type": "boolean"
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "observation_id",
          "text",
          "recorded_on"
        ],
        "additionalProperties": false,
        "properties": {
          "observation_id": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "text": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "related_fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "recorded_on": {
            "$ref": "#/$defs/isoDate"
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "assumption_id",
          "statement",
          "rationale",
          "impact_if_wrong"
        ],
        "additionalProperties": false,
        "properties": {
          "assumption_id": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "statement": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "rationale": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "impact_if_wrong": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "reproducibility": {
      "type": "object",
      "required": [
        "method",
        "tooling",
        "replay_notes"
      ],
      "additionalProperties": false,
      "properties": {
        "method": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "tooling": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "replay_notes": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    }
  }
}
