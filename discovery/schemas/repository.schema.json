{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://eduvijna.local/discovery/schemas/repository.schema.json",
  "title": "Repository Discovery Inventory",
  "description": "Validates repository discovery inventories completed from discovery/templates/repository-template.yaml. Metadata and evidence are defined in common-metadata.schema.json.",
  "type": "object",
  "required": [
    "metadata",
    "repository",
    "evidence",
    "unknown_value_policy",
    "reproducibility"
  ],
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "allOf": [
        {
          "$ref": "common-metadata.schema.json#/$defs/metadata"
        },
        {
          "type": "object",
          "properties": {
            "discovery_type": {
              "const": "repository"
            }
          }
        }
      ]
    },
    "repository": {
      "type": "object",
      "required": [
        "repository_id",
        "name",
        "clone_url",
        "web_url",
        "visibility",
        "hosting_platform",
        "default_branch",
        "primary_language",
        "lifecycle",
        "criticality",
        "classification",
        "ownership"
      ],
      "additionalProperties": false,
      "properties": {
        "repository_id": {
          "type": "string",
          "pattern": "^REPO-[A-Za-z0-9][A-Za-z0-9._-]*$",
          "description": "Stable identifier for the repository asset (not the inventory). Distinct from metadata.discovery_id."
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "clone_url": {
          "$ref": "#/$defs/stringOrUnknown"
        },
        "web_url": {
          "$ref": "#/$defs/stringOrUnknown"
        },
        "visibility": {
          "type": "string",
          "enum": [
            "public",
            "internal",
            "private",
            "UNKNOWN"
          ]
        },
        "hosting_platform": {
          "$ref": "#/$defs/stringOrUnknown"
        },
        "default_branch": {
          "$ref": "#/$defs/stringOrUnknown"
        },
        "primary_language": {
          "$ref": "#/$defs/stringOrUnknown"
        },
        "lifecycle": {
          "$ref": "#/$defs/repositoryLifecycle"
        },
        "criticality": {
          "$ref": "#/$defs/repositoryCriticality"
        },
        "classification": {
          "$ref": "#/$defs/repositoryClassification"
        },
        "ownership": {
          "type": "object",
          "required": [
            "organisational_owner",
            "technical_owner",
            "codeowners_present"
          ],
          "additionalProperties": false,
          "properties": {
            "organisational_owner": {
              "$ref": "#/$defs/stringOrUnknown"
            },
            "technical_owner": {
              "$ref": "#/$defs/stringOrUnknown"
            },
            "codeowners_present": {
              "type": "string",
              "enum": [
                "true",
                "false",
                "UNKNOWN"
              ]
            }
          }
        }
      }
    },
    "evidence": {
      "$ref": "common-metadata.schema.json#/$defs/evidence"
    },
    "unknown_value_policy": {
      "$ref": "#/$defs/unknownValuePolicy"
    },
    "observations": {
      "$ref": "#/$defs/observations"
    },
    "assumptions": {
      "$ref": "#/$defs/assumptions"
    },
    "reproducibility": {
      "$ref": "#/$defs/reproducibility"
    },
    "repository_optional": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "created_on_host": {
          "$ref": "#/$defs/dateOrEmpty"
        },
        "last_activity_on": {
          "$ref": "#/$defs/dateOrEmpty"
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "related_application_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "monorepo": {
          "type": "string",
          "enum": [
            "true",
            "false",
            "UNKNOWN",
            ""
          ]
        },
        "ci_cd_present": {
          "type": "string",
          "enum": [
            "true",
            "false",
            "UNKNOWN",
            ""
          ]
        },
        "readme_present": {
          "type": "string",
          "enum": [
            "true",
            "false",
            "UNKNOWN",
            ""
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringOrUnknown": {
      "type": "string",
      "minLength": 1
    },
    "repositoryLifecycle": {
      "type": "string",
      "enum": [
        "production",
        "active",
        "experimental",
        "archived",
        "planned",
        "deprecated",
        "UNKNOWN"
      ],
      "description": "Repository lifecycle state. Distinct from classification."
    },
    "repositoryCriticality": {
      "type": "string",
      "enum": [
        "Critical",
        "High",
        "Medium",
        "Low",
        "UNKNOWN"
      ],
      "description": "Business/operational criticality for risk, modernization, and incident planning."
    },
    "repositoryClassification": {
      "type": "string",
      "enum": [
        "Governance",
        "Engineering",
        "Platform",
        "Runtime",
        "Infrastructure",
        "Research",
        "Experimental",
        "Archive",
        "UNKNOWN"
      ],
      "description": "Frozen repository classification vocabulary (EAO-approved)."
    },
    "isoDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "dateOrEmpty": {
      "type": "string",
      "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$"
    },
    "tfu": {
      "type": "string",
      "enum": [
        "true",
        "false",
        "UNKNOWN"
      ]
    },
    "tfuEmpty": {
      "type": "string",
      "enum": [
        "true",
        "false",
        "UNKNOWN",
        ""
      ]
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unknownValuePolicy": {
      "type": "object",
      "required": [
        "statement",
        "marker",
        "fields_marked_unknown",
        "rationale_required"
      ],
      "additionalProperties": false,
      "properties": {
        "statement": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "marker": {
          "const": "UNKNOWN"
        },
        "fields_marked_unknown": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rationale_required": {
          "type": "boolean"
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "observation_id",
          "text",
          "recorded_on"
        ],
        "additionalProperties": false,
        "properties": {
          "observation_id": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "text": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "related_fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "recorded_on": {
            "$ref": "#/$defs/isoDate"
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "assumption_id",
          "statement",
          "rationale",
          "impact_if_wrong"
        ],
        "additionalProperties": false,
        "properties": {
          "assumption_id": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "statement": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "rationale": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "impact_if_wrong": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "reproducibility": {
      "type": "object",
      "required": [
        "method",
        "tooling",
        "replay_notes"
      ],
      "additionalProperties": false,
      "properties": {
        "method": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "tooling": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "replay_notes": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    }
  }
}
