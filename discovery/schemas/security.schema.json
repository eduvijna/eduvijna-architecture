{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://eduvijna.local/discovery/schemas/security.schema.json",
  "title": "Security Discovery Inventory",
  "description": "Validates security discovery inventories completed from discovery/templates/security-template.yaml. Metadata and evidence are defined in common-metadata.schema.json.",
  "type": "object",
  "required": [
    "metadata",
    "security",
    "evidence",
    "unknown_value_policy",
    "reproducibility"
  ],
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "allOf": [
        {
          "$ref": "common-metadata.schema.json#/$defs/metadata"
        },
        {
          "type": "object",
          "properties": {
            "discovery_type": {
              "const": "security"
            }
          }
        }
      ]
    },
    "security": {
      "type": "object",
      "required": [
        "security_item_id",
        "name",
        "category",
        "scope",
        "technical_owner",
        "control_status"
      ],
      "additionalProperties": false,
      "properties": {
        "security_item_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "category": {
          "type": "string",
          "enum": [
            "identity",
            "access",
            "encryption",
            "network",
            "secrets",
            "compliance",
            "vulnerability",
            "other",
            "UNKNOWN"
          ]
        },
        "scope": {
          "$ref": "#/$defs/stringOrUnknown"
        },
        "technical_owner": {
          "$ref": "#/$defs/stringOrUnknown"
        },
        "control_status": {
          "type": "string",
          "enum": [
            "present",
            "partial",
            "absent",
            "UNKNOWN"
          ]
        }
      }
    },
    "evidence": {
      "$ref": "common-metadata.schema.json#/$defs/evidence"
    },
    "unknown_value_policy": {
      "$ref": "#/$defs/unknownValuePolicy"
    },
    "observations": {
      "$ref": "#/$defs/observations"
    },
    "assumptions": {
      "$ref": "#/$defs/assumptions"
    },
    "reproducibility": {
      "$ref": "#/$defs/reproducibility"
    },
    "security_optional": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "related_application_ids": {
          "$ref": "#/$defs/stringList"
        },
        "related_repository_ids": {
          "$ref": "#/$defs/stringList"
        },
        "related_infrastructure_ids": {
          "$ref": "#/$defs/stringList"
        },
        "framework_refs": {
          "$ref": "#/$defs/stringList"
        },
        "residual_risk_known": {
          "$ref": "#/$defs/tfuEmpty"
        },
        "last_assessed_on": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringOrUnknown": {
      "type": "string",
      "minLength": 1
    },
    "isoDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "dateOrEmpty": {
      "type": "string",
      "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$"
    },
    "tfu": {
      "type": "string",
      "enum": [
        "true",
        "false",
        "UNKNOWN"
      ]
    },
    "tfuEmpty": {
      "type": "string",
      "enum": [
        "true",
        "false",
        "UNKNOWN",
        ""
      ]
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unknownValuePolicy": {
      "type": "object",
      "required": [
        "statement",
        "marker",
        "fields_marked_unknown",
        "rationale_required"
      ],
      "additionalProperties": false,
      "properties": {
        "statement": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "marker": {
          "const": "UNKNOWN"
        },
        "fields_marked_unknown": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rationale_required": {
          "type": "boolean"
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "observation_id",
          "text",
          "recorded_on"
        ],
        "additionalProperties": false,
        "properties": {
          "observation_id": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "text": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "related_fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "recorded_on": {
            "$ref": "#/$defs/isoDate"
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "assumption_id",
          "statement",
          "rationale",
          "impact_if_wrong"
        ],
        "additionalProperties": false,
        "properties": {
          "assumption_id": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "statement": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "rationale": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "impact_if_wrong": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "reproducibility": {
      "type": "object",
      "required": [
        "method",
        "tooling",
        "replay_notes"
      ],
      "additionalProperties": false,
      "properties": {
        "method": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "tooling": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "replay_notes": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    }
  }
}
